{
  "name": "xentool",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Cloudflare Worker tool platform",
  "main": "src/index.js",
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "embed": "node scripts/embed-core.mjs",
    "probe": "node test/layout-probe.mjs",
    "drawer": "node test/drawer-check.mjs",
    "portal": "node test/portal-check.mjs",
    "tools:check": "node test/tools-check.mjs",
    "contrast": "node test/contrast-check.mjs",
